rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User-entered application data. These collections are intentionally
    // explicit: a recursive /users/{uid}/{document=**} rule would also grant
    // writes to private subscription data because matching Firestore allows
    // are ORed rather than overridden by a more-specific match.
    match /users/{uid}/lancamentos/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/categorias/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/regrasCategorizacao/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/recorrencias/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/metas/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/gestorLancamentos/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/planejamento/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/valorLivre/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Monthly closings are immutable snapshots: the owner may create and
    // read them, but editing would invalidate the historical reconciliation.
    match /users/{uid}/fechamentos/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if false;
      // Deletion remains available only so the account-deletion flow can
      // remove every user-owned document.
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/config/{docId} {
      allow read, write: if isOwner(uid);
    }

    // The client may create only the complete initial free subscription and
    // perform the exact one-time none -> trialing transition. Paid status,
    // renewals and cancellations are written by Admin SDK code, which bypasses
    // these rules.
    match /users/{uid}/private/subscription {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'plan',
          'subscriptionStatus',
          'subscriptionProvider',
          'subscriptionId',
          'currentPeriodEnd',
          'cancelAtPeriodEnd',
          'trialStartedAt',
          'trialEndsAt',
          'founder',
          'createdAt'
        ])
        && request.resource.data.plan == 'free'
        && request.resource.data.subscriptionStatus == 'none'
        && request.resource.data.subscriptionProvider == 'manual'
        && request.resource.data.subscriptionId == null
        && request.resource.data.currentPeriodEnd == null
        && request.resource.data.cancelAtPeriodEnd == false
        && request.resource.data.trialStartedAt == null
        && request.resource.data.trialEndsAt == null
        && request.resource.data.founder == false
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && resource.data.subscriptionStatus == 'none'
        && resource.data.trialStartedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'plan',
          'subscriptionStatus',
          'subscriptionProvider',
          'subscriptionId',
          'cancelAtPeriodEnd',
          'trialStartedAt',
          'trialEndsAt'
        ])
        && request.resource.data.plan == 'premium'
        && request.resource.data.subscriptionStatus == 'trialing'
        && request.resource.data.subscriptionProvider == 'web'
        && request.resource.data.subscriptionId == null
        && request.resource.data.cancelAtPeriodEnd == false
        && request.resource.data.currentPeriodEnd == resource.data.currentPeriodEnd
        && request.resource.data.founder == resource.data.founder
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.trialStartedAt == request.time
        && request.resource.data.trialEndsAt > request.time + duration.value(13, 'd')
        && request.resource.data.trialEndsAt < request.time + duration.value(15, 'd');

      // Private deletion is performed by the authenticated backend endpoint
      // during account deletion. Allowing direct deletion would let a client
      // recreate this document and repeatedly claim a new trial.
      allow delete: if false;
    }

    match /users/{uid}/private/subscription/subscription_log/{logId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
